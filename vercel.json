{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/picture/:id", "destination": "/hasil.html" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [ { "key": "Permissions-Policy", "value": "camera=(self)" } ] }
  ],
  "crons": [
    { "path": "/api/cleanup", "schedule": "0 19 * * *" }
  ]
}
